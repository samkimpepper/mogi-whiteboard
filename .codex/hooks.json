{
  "description": "Archive visible Mogi and Whiteboard Cat root-thread messages locally.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/integrations/codex-chat/bin/archive-hook.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/integrations/codex-chat/bin/archive-hook.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
